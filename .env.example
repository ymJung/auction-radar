# Docker MySQL Configuration (Loaded from ~/.env by default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=auction_radar

# Telegram Notification Settings (Save in ~/.env or project .env)
TELEGRAM_USER_ID=your_telegram_chat_id_here
TELEGRAM_BOT_2=1234567890:AAH_your_telegram_bot_token_here

# Optional API Keys
MOLIT_API_KEY=your_public_data_portal_api_key
GEMINI_API_KEY=your_gemini_api_key
